# AWS Configuration
AWS_REGION=eu-west-2
AWS_DEFAULT_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# AWS EMF Configuration (for python services)
AWS_EMF_ENVIRONMENT=local
AWS_EMF_AGENT_ENDPOINT=tcp://127.0.0.1:25888
AWS_EMF_LOG_GROUP_NAME=log-group-name
AWS_EMF_LOG_STREAM_NAME=log-stream-name
AWS_EMF_NAMESPACE=namespace
AWS_EMF_SERVICE_NAME=service-name
AWS_EMF_SERVICE_TYPE=python-backend-service

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PORT=5432
POSTGRES_PASSWORD=ppp
POSTGRES_SSL_MODE=disable

# LocalStack endpoints
LOCALSTACK_URL=http://localstack:4566
S3_ENDPOINT=http://localstack:4566
S3_ENDPOINT_URL=http://localstack:4566
SQS_ENDPOINT=http://localstack:4566
SQS_ENDPOINT_URL=http://localstack:4566

# AWS Bedrock Configuration
AWS_BEARER_TOKEN_BEDROCK=

# ai-uc-rag-evaluation-ui
BACKEND_RAG_SERVICE_HOST=http://ai-uc-rag-evaluation-data:8086
EVALUATION_SERVICE_HOST=http://ai-uc-rag-evaluation-runtime:8085

# ai-uc-rag-evaluation-runtime
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_INFERENCE_PROFILE_ARN=
INGESTION_DATA_BUCKET_NAME=ai-uc-rag-evaluation-data-ingestion-data
CDP_UPLOADER_URL=http://host.docker.internal:7337
UPLOAD_CALLBACK_BASE_URL=http://host.docker.internal:8086

# ai-uc-rag-evaluation-runtime
EVALUATION_DATA_SERVICE_URL=http://ai-uc-rag-evaluation-data:8086

# Config for ai-uc-rag-evaluation-runtime, settings should be in KEY=value format
LLM_AS_A_JUDGE_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
LLM_AS_A_JUDGE_INFERENCE_PROFILE_ARN=
LLM_AS_A_JUDGE_GUARDRAILS_ID=
LLM_AS_A_JUDGE_GUARDRAILS_VERSION=1

